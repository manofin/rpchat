# ---- 서버 바인딩 (베어메탈은 127.0.0.1, docker compose는 compose 파일이 0.0.0.0으로 덮어씀) ----
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
LOG_LEVEL=info

# ---- 모델 (Mac Studio의 OpenAI 호환 서버) ----
# Tailscale IP 또는 MagicDNS 이름. 끝에 /v1 포함.
MODEL_BASE_URL=http://100.64.0.2:8080/v1
MODEL_API_KEY=
# 비우면 시작 시 /v1/models 첫 항목을 사용. 프로필별로 다른 모델을 쓰려면 model_profiles.model 에 지정.
MODEL_NAME=
# 서버가 컨텍스트 상한을 강제하지 않을 수 있으므로 앱이 직접 예산을 지킨다. 실제 창 크기로 설정.
CONTEXT_TOKENS=32768
MODEL_TIMEOUT_MS=180000

# ---- 인증: tailscale | token | none ----
# tailscale: Tailscale Serve가 붙이는 Tailscale-User-Login 헤더가 ALLOWED_LOGIN 과 일치해야 통과.
#            반드시 HOST=127.0.0.1 (또는 compose의 127.0.0.1:8787 포트 바인딩) 과 함께 써야 헤더 위조가 차단됨.
# token:     최초 1회 APP_TOKEN 입력 → HttpOnly 쿠키 세션. SESSION_SECRET 32자 이상.
# none:      로컬 개발 전용.
AUTH_MODE=tailscale
ALLOWED_LOGIN=you@github
APP_TOKEN=
SESSION_SECRET=
SESSION_TTL_HOURS=12

# 빌드된 웹 번들 경로 (apps/server 기준). 없으면 API 전용으로 동작.
WEB_DIST=../web/dist
