# RP Chat 배포용 환경변수 예시 — deploy/.env 또는 /opt/rpchat/.env 로 복사해 사용

# ── 서버 바인딩 ─────────────────────────────
PORT=8787
# Node 직접 실행 시 반드시 루프백. (Tailscale Serve 가 프록시하므로 외부 바인딩 불필요)
HOST=127.0.0.1
# Docker 사용 시 컨테이너 내부는 0.0.0.0, 외부 노출은 compose 의 "127.0.0.1:8787:8787" 매핑으로 제한.
DATA_DIR=/var/lib/rpchat
WEB_DIST=../web/dist
LOG_LEVEL=info

# ── 로컬 모델 (Mac Studio, OpenAI 호환) ──────
# Tailscale 내부 주소 권장. mlx-openai-server / vLLM 등의 /v1 엔드포인트.
MODEL_BASE_URL=http://100.100.100.100:8080/v1
# 비우면 /v1/models 의 첫 모델을 자동 사용
MODEL_NAME=
CONTEXT_TOKENS=32768
MODEL_TIMEOUT_MS=180000

# ── 인증 ────────────────────────────────────
# tailscale: Tailscale Serve 가 주입하는 Tailscale-User-Login 헤더로 신원 확인 (권장)
# token    : 접근 토큰 + 쿠키 세션 (HTTPS 필수 → Tailscale Serve 경유)
# none     : 인증 없음. HOST=127.0.0.1 전용, 신뢰된 단일 사용자 로컬 개발에만.
AUTH_MODE=tailscale

# tailscale 모드: 허용할 본인 Tailscale 로그인(이메일 등). 이 값과 일치해야 접근 허용.
ALLOWED_LOGIN=you@example.com

# token 모드에서만 필요:
# APP_TOKEN=16자-이상-무작위-토큰
# SESSION_SECRET=32자-이상-무작위-쿠키-서명키
